# Semua request diarahkan ke public/. Folder app/, database/, storage/, routes/
# tidak pernah dapat diakses langsung dari browser (tidak ada di public/).
Options -Indexes
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^$ public/ [L]
    RewriteRule ^(?!public/)(.*)$ public/$1 [L]
</IfModule>
